#!/usr/bin/env bash
set -Eeuo pipefail
echo '==> APT: update metadata and packages'
sudo apt-get update
sudo apt-get full-upgrade
echo '==> Flatpak (user scope)'
if command -v flatpak >/dev/null; then flatpak update --user; fi
if command -v snap >/dev/null 2>&1; then
  echo '==> Snap store apps (if present)'
  sudo snap refresh
fi
if command -v rustup >/dev/null 2>&1; then
  echo '==> rustup toolchains'
  rustup update
fi
echo '==> Firmware: report only (never flash automatically)'
if command -v fwupdmgr >/dev/null; then fwupdmgr get-updates || true; fi
echo '==> Reminder: Krita/KiCad/FreeCAD/Blender/Joplin/Thunderbird/Calibre plugins update in their app managers.'
echo '==> No unattended firmware, NVIDIA or release upgrade.'
