#!/usr/bin/env bash
# Kubuntu_Config maintenance controller. Interactive runs in the caller's TTY;
# automatic runs as a detached, systemd-supervised system service.
set -uo pipefail
umask 077

SELF="$(readlink -f -- "${BASH_SOURCE[0]}")"
CALLER_UID="$(id -u)"
CALLER_HOME="$HOME"
ROOT="${KUBUNTU_CONFIG_ROOT:-$HOME/kubuntu_config}"
USER_STATE="$HOME/.local/state/kubuntu-config"
SYSTEM_STATE_BASE="/var/lib/kubuntu-sysup"
WORKER_BINARY="/usr/local/libexec/kubuntu-sysup"
RUN_ID="$(date -u +%Y%m%dT%H%M%SZ)-$$"
UNIT=""
MODE="interactive"
RESUME=0
CANCEL_REQUESTED=0
FAILED=0
WARNINGS=0
RUN_STAGE_PID=""
RUN_STAGE_HEARTBEAT=""
STAGE="idle"
STATUS="idle"
DETAIL=""
SYSUP_TTY_COLOR=0

usage() {
    cat <<'HELP'
Usage: sysup [check|apply|auto|resume [--auto]|status|summary|logs|doctor|cancel]
  check         read-only pending updates
  apply         interactive update (default); terminal must remain open
  auto          detached, noninteractive systemd service
  resume        resume successful stage checkpoints interactively
  resume --auto resume automatic service checkpoints
  status        colored final summary and current process state
  summary       latest readable update summary
  logs          latest interactive log and detached service journal
  doctor        read-only package manager / DNS diagnostics
  cancel        request cancellation AFTER the currently running stage
The automatic service is detached and survives closing Alacritty. Neither
cancel nor timeout forcibly kills an active apt/dpkg transaction.
HELP
}

error() { printf '[FAIL] %s\n' "$*" >&2; }
info()  { printf '[INFO] %s\n' "$*"; }
warn()  { printf '[WARN] %s\n' "$*" >&2; }

# This file is written by root inside a root-owned directory in automatic mode.
# Interactive runs keep files in the user's private state directory.
write_status() {
    local phase="$1" detail="${2:-}"
    STATUS="$phase"
    DETAIL="$detail"
    python3 - "$STATE/status.json" "$RUN_ID" "$MODE" "$UNIT" "$$" "$STAGE" "$phase" "$detail" "$FAILED" "$WARNINGS" <<'PY'
import json, os, sys, tempfile
path, run_id, mode, unit, pid, stage, phase, detail, failures, warnings = sys.argv[1:]
obj = {"run_id": run_id, "mode": mode, "unit": unit, "pid": int(pid),
       "stage": stage, "status": phase, "detail": detail,
       "failures": int(failures), "warnings": int(warnings)}
fd, temp = tempfile.mkstemp(prefix='.sysup-status-', dir=os.path.dirname(path))
try:
    with os.fdopen(fd, 'w', encoding='utf-8') as stream:
        json.dump(obj, stream, ensure_ascii=False)
        stream.write('\n')
        stream.flush()
        os.fsync(stream.fileno())
    os.chmod(temp, 0o644)
    os.replace(temp, path)
finally:
    if os.path.exists(temp): os.unlink(temp)
PY
}

event() {
    local kind="$1" message="${2:-}" code="${3:-0}"
    python3 - "$STATE/events.jsonl" "$RUN_ID" "$STAGE" "$kind" "$message" "$code" <<'PY'
import datetime, json, sys
path, run_id, stage, kind, message, rc = sys.argv[1:]
with open(path, 'a', encoding='utf-8') as f:
    json.dump({"timestamp": datetime.datetime.now(datetime.timezone.utc).isoformat(),
               "run_id": run_id, "stage": stage, "event": kind,
               "message": message, "exit_code": int(rc)}, f, ensure_ascii=False)
    f.write('\n')
PY
}


# A per-run summary is constructed from the existing structured event log.
# No sensitive package output is exposed in the public-readable summary.
# A successful stage indicates the command completed, not necessarily that
# a package changed version. The last summary can be reviewed after logout.
summary_report() {
    local action="$1" state="$2" color="$3"
    local saved_log=""
    if [[ "$action" != view ]]; then saved_log="$LOG"; fi
    python3 - "$action" "$state/status.json" "$state/events.jsonl" "$state/summary.json" "$color" "$saved_log" <<'PY'
import datetime as dt
import json
import os
import sys
import tempfile

action, status_path, events_path, summary_path, color, log_path = sys.argv[1:]
if action != 'view':
    with open(status_path, encoding='utf-8') as handle:
        status = json.load(handle)
    run_id = status['run_id']
    stages = []
    pending = {}
    warnings = 0
    begin = None
    for raw in open(events_path, encoding='utf-8'):
        event = json.loads(raw)
        if event.get('run_id') != run_id:
            continue
        kind, key = event.get('event'), event.get('stage')
        when = dt.datetime.fromisoformat(event['timestamp'])
        if kind == 'start':
            begin = when
        elif kind == 'stage_start':
            row = {'key': key, 'name': event.get('message') or key,
                   'outcome': 'running', 'seconds': 0, 'code': 0,
                   'reason': '', 'started': when}
            pending[key] = row
            stages.append(row)
        elif kind in ('stage_ok', 'stage_failed', 'skipped'):
            if kind == 'skipped':
                row = {'key': key, 'name': str(event.get('message', key)).replace(' already completed', ''),
                       'outcome': 'skipped', 'seconds': 0, 'code': 0, 'reason': 'Previously completed'}
                stages.append(row)
                continue
            row = pending.pop(key, None)
            if row is None:
                row = {'key': key, 'name': event.get('message') or key,
                       'outcome': 'running', 'seconds': 0, 'code': 0, 'reason': ''}
                stages.append(row)
            row['outcome'] = 'success' if kind == 'stage_ok' else 'failed'
            row['code'] = int(event.get('exit_code') or 0)
            row['reason'] = '' if kind == 'stage_ok' else str(event.get('message') or '')
            started = row.pop('started', when)
            row['seconds'] = max(0, int((when - started).total_seconds()))
        elif kind == 'warning':
            warnings += 1
    for row in stages:
        row.pop('started', None)
    ended = dt.datetime.now(dt.timezone.utc)
    totals = {name: sum(row['outcome'] == name for row in stages)
              for name in ('success', 'failed', 'skipped', 'running')}
    summary = {'run_id': run_id, 'mode': status.get('mode'),
               'status': status.get('status'), 'detail': status.get('detail'),
               'started_at': begin.isoformat() if begin else '',
               'finished_at': ended.isoformat(),
               'elapsed_seconds': max(0, int((ended - begin).total_seconds())) if begin else 0,
               'counts': totals, 'warnings': warnings, 'stages': stages,
               'log': log_path}
    fd, tmp = tempfile.mkstemp(prefix='.sysup-summary-', dir=os.path.dirname(summary_path))
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as handle:
            json.dump(summary, handle, ensure_ascii=False, indent=2)
            handle.write('\n')
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(tmp, 0o644)
        os.replace(tmp, summary_path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)
    if action == 'save':
        sys.exit(0)
else:
    with open(summary_path, encoding='utf-8') as handle:
        summary = json.load(handle)

colored = ((color == 'yes') or (color == 'auto' and sys.stdout.isatty()))
colored = colored and ('NO_COLOR' not in os.environ) and (os.environ.get('TERM') != 'dumb')
def c(message, code):
    return f'\033[{code}m{message}\033[0m' if colored else message

phases = {
    'completed': ('TAMAMLANDI', '1;32'),
    'failed': ('HATALARLA TAMAMLANDI', '1;31'),
    'partial': ('UYARILARLA TAMAMLANDI', '1;33'),
    'cancelled': ('İPTAL EDİLDİ', '1;33'),
    'running': ('DEVAM EDİYOR', '1;36'),
}
results = {
    'success': ('BAŞARILI', '32'),
    'failed': ('HATA', '31'),
    'skipped': ('ATLANDI', '33'),
    'running': ('BEKLİYOR', '36'),
}
phase, phase_color = phases.get(summary.get('status'), ('BİLİNMİYOR', '33'))
print()
print(c('═' * 75, '36'))
print(c('  SYSUP  |  SİSTEM GÜNCELLEME ÖZETİ', '1;36'))
print(c('═' * 75, '36'))
print('  Durum      : ' + c(phase, phase_color))
print('  Mod        : ' + ('Otomatik (systemd)' if summary.get('mode') == 'automatic' else 'İnteraktif'))
print('  Çalışma    : ' + str(summary.get('run_id', '-')))
print('  Başlangıç  : ' + str(summary.get('started_at') or '-') + ' (UTC)')
print('  Toplam süre: ' + str(summary.get('elapsed_seconds', 0)) + ' sn')
print(c('─' * 75, '90'))
print(f"  {'AŞAMA':<39} {'SONUÇ':<15} SÜRE")
print(c('─' * 75, '90'))
for stage in summary.get('stages', []):
    word, tone = results.get(stage.get('outcome'), ('BİLİNMİYOR', '33'))
    name = str(stage.get('name') or stage.get('key') or '')[:39]
    print(f"  {name:<39} {c(f'{word:<15}', tone)} {stage.get('seconds', 0)} sn")
    if stage.get('outcome') == 'failed':
        print('    ' + c('↳ ' + str(stage.get('reason') or ('Exit code ' + str(stage.get('code'))))[:96], '31'))
if not summary.get('stages'):
    print('  Kaydedilmiş aşama bulunmuyor.')
print(c('─' * 75, '90'))
counts = summary.get('counts', {})
print('  ' + c(f"Başarılı: {counts.get('success', 0)}", '32') + '   '
      + c(f"Hata: {counts.get('failed', 0)}", '31') + '   '
      + c(f"Uyarı: {summary.get('warnings', 0)}", '33') + '   '
      + c(f"Atlanan: {counts.get('skipped', 0)}", '33'))
if summary.get('status') in ('failed', 'partial', 'cancelled'):
    print(c('  Ayrıntılar: sysup logs  |  Sorun analizi: sysup doctor', '33'))
else:
    print(c('  Aşama başarılı olabilir; güncellenecek paket bulunmamış olabilir.', '90'))
if summary.get('log'):
    print('  Log: ' + str(summary['log']))
print(c('═' * 75, '36'))
print()
PY
}

get_field() {
    local path="$1" field="$2"
    [[ -r "$path" ]] || return 1
    python3 - "$path" "$field" <<'PY'
import json,sys
try:
    with open(sys.argv[1], encoding='utf-8') as f: obj=json.load(f)
    value=obj.get(sys.argv[2], '')
    print(value if value is not None else '')
except (OSError,ValueError): sys.exit(1)
PY
}

# Avoid acquiring/creating an APT lock manually: only the native apt/dpkg
# processes own theirs. flock --close prevents script descendants inheriting
# our maintenance lock, which previously survived orphaned shells.
locked_execute() {
    local state="$1"
    shift
    mkdir -p -- "$state"
    local lock="$USER_STATE/bootstrap.lock"
    [[ -f "$lock" && ! -L "$lock" ]] || { error "Unsafe or missing maintenance lock: $lock"; return 2; }
    flock --exclusive --nonblock --close --conflict-exit-code 75 "$lock" "$SELF" __execute "$@"
    local rc=$?
    if ((rc == 75)); then error 'Another bootstrap/sysup operation is running'; fi
    return "$rc"
}

request_cancel() {
    CANCEL_REQUESTED=1
    warn 'Cancellation requested: current operation will finish before stopping.'
    write_status 'cancel_requested' 'Waiting for current stage to finish' || true
    event cancel 'Cancellation requested' || true
}

setup_run_state() {
    local existing
    if ((RESUME)); then
        if [[ ! -s "$STATE/completed.txt" && ! -f "$STATE/status.json" ]]; then
            error "No previous run to resume in $STATE"; return 2
        fi
        existing="$(get_field "$STATE/status.json" status 2>/dev/null || true)"
        if [[ "$existing" == completed ]]; then
            error 'Previous run already completed; use apply/auto for a fresh update'; return 2
        fi
        info "Resuming checkpoint from $STATE"
    else
        : > "$STATE/completed.txt"
    fi
    # Capture terminal color capability before tee redirects stdout to a pipe.
    if [[ -t 1 && -z "${NO_COLOR+x}" && "${TERM:-dumb}" != dumb ]]; then
        SYSUP_TTY_COLOR=1
    fi
    # Every attempted run gets a new log; JSONL retains the historical events.
    LOG="$STATE/sysup-$RUN_ID.log"
    exec > >(tee -a "$LOG") 2>&1
    trap request_cancel USR1
    trap request_cancel INT
    # HUP/TERM are handled as deferred requests only when the session survives.
    trap request_cancel HUP TERM
    trap '[[ -z "$RUN_STAGE_HEARTBEAT" ]] || kill "$RUN_STAGE_HEARTBEAT" 2>/dev/null || true' EXIT
    STAGE='preflight'
    write_status running 'Checking package manager state'
    event start "mode=$MODE resume=$RESUME"
    info "Run: $RUN_ID | Mode: $MODE | Log: $LOG"
}

# In automatic mode the supervisor is root, but ALL user installations run
# unprivileged as the real desktop owner, never as root.
user_cmd() {
    if [[ "$MODE" == automatic ]]; then
        runuser -u "$TARGET_USER" -- env \
            HOME="$TARGET_HOME" USER="$TARGET_USER" LOGNAME="$TARGET_USER" \
            XDG_RUNTIME_DIR="/run/user/$TARGET_UID" \
            DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$TARGET_UID/bus" \
            PATH="$TARGET_HOME/.cargo/bin:$TARGET_HOME/.local/bin:/usr/local/bin:/usr/bin:/bin" "$@"
    else
        "$@"
    fi
}

root_cmd() {
    if [[ "$MODE" == automatic ]]; then "$@"; else sudo "$@"; fi
}

apt_clean() {
    local audit
    audit="$(dpkg --audit 2>&1)" || return 1
    if [[ -n "$audit" ]]; then
        warn "Incomplete dpkg configuration detected:\n$audit"
        return 1
    fi
}

# DNS preflight is bounded (15 seconds per check). Only DNS checks are
# retried. Never retry interrupted dpkg/apt package installation commands.
network_ready() {
    local host="$1" pause
    for pause in 0 5 15 30; do
        if ((CANCEL_REQUESTED)); then return 130; fi
        if ((pause > 0)); then
            warn "DNS $host unreachable; retrying in ${pause}s"
            sleep "$pause" || true
        fi
        if timeout 15 getent ahosts "$host" >/dev/null 2>&1; then return 0; fi
    done
    return 75
}

run_apt_update() {
    root_cmd apt-get -o Acquire::Retries=2 -o APT::Update::Error-Mode=any update
}

run_apt_upgrade() {
    if [[ "$MODE" == automatic ]]; then
        env DEBIAN_FRONTEND=noninteractive APT_LISTCHANGES_FRONTEND=none \
            apt-get -o DPkg::Lock::Timeout=30 \
            -o Dpkg::Options::=--force-confdef \
            -o Dpkg::Options::=--force-confold \
            --no-remove --yes full-upgrade </dev/null
    else
        sudo apt-get -o DPkg::Lock::Timeout=30 --no-remove --yes full-upgrade
    fi
}

run_flatpak() {
    local capture rc=0
    capture="$(mktemp)" || return 1
    user_cmd flatpak update --user --assumeyes --noninteractive >"$capture" 2>&1 || rc=$?
    cat "$capture"
    if grep -Eqi 'Warning: Treating remote fetch error|No such ref .* in remote' "$capture"; then
        warn 'Flatpak remote reported unresolved references; result is not verified.'
        event warning 'Flatpak remote reference warnings' || true
        # Return a special code so the stage is not checkpointed as clean.
        ((rc == 0)) && rc=3
    fi
    rm -f -- "$capture"
    return "$rc"
}

run_rustup() {
    local path
    # Resolve using the real user's PATH, not the root service PATH.
    path="$(user_cmd /bin/sh -c 'command -v rustup' 2>/dev/null || true)"
    [[ -n "$path" ]] || return 0
    path="$(readlink -f "$path")"
    if dpkg-query -S "$path" >/dev/null 2>&1; then
        user_cmd rustup update --no-self-update
    else
        user_cmd rustup update
    fi
}

firmware_report() {
    local rc=0
    root_cmd fwupdmgr get-updates || rc=$?
    [[ "$rc" == 0 || "$rc" == 2 ]]
}

run_stage() {
    local key="$1" label="$2" host="$3"; shift 3
    local rc=0 started=$SECONDS
    STAGE="$key"
    if ((RESUME)) && grep -Fqx -- "$key" "$STATE/completed.txt" 2>/dev/null; then
        info "[SKIP] $label: previously completed"
        event skipped "$label already completed"
        return 0
    fi
    if ((CANCEL_REQUESTED)); then return 130; fi
    printf '\n==> %s\n' "$label"
    write_status running "$label"
    event stage_start "$label"
    if [[ "$host" != '-' ]]; then
        network_ready "$host" || rc=$?
        if ((rc != 0)); then
            warn "$label: network preflight failed for $host (rc=$rc)"
            ((FAILED+=1))
            event stage_failed "DNS preflight: $host" "$rc"
            write_status failed "$label: DNS $host"
            return 0
        fi
    fi

    # wait can be interrupted by SIGUSR1. Never mistake an interrupted wait
    # for child completion, and never send SIGKILL to apt/dpkg on cancel.
    "$@" &
    RUN_STAGE_PID=$!
    (
        while sleep 30; do
            info "$label running ($((SECONDS-started))s); cancellation deferred until completion"
        done
    ) &
    RUN_STAGE_HEARTBEAT=$!
    while :; do
        wait "$RUN_STAGE_PID" && rc=0 || rc=$?
        if ((rc > 128)) && kill -0 "$RUN_STAGE_PID" 2>/dev/null; then
            continue
        fi
        break
    done
    kill "$RUN_STAGE_HEARTBEAT" 2>/dev/null || true
    wait "$RUN_STAGE_HEARTBEAT" 2>/dev/null || true
    RUN_STAGE_PID=""
    RUN_STAGE_HEARTBEAT=""

    if ((rc == 3)) && [[ "$key" == flatpak ]]; then
        ((WARNINGS+=1))
    fi
    if ((rc == 0)); then
        info "[OK] $label ($((SECONDS-started))s)"
        printf '%s\n' "$key" >> "$STATE/completed.txt"
        event stage_ok "$label"
    else
        error "$label failed (exit $rc)"
        ((FAILED+=1))
        event stage_failed "$label" "$rc"
    fi
    write_status running "$label done (exit $rc)"
    return 0
}

finish_run() {
    local rc=0 color=no
    STAGE='finished'
    if ((CANCEL_REQUESTED)); then
        warn "Cancelled safely at a stage boundary; $FAILED stage(s) failed"
        write_status cancelled 'Cancellation completed at stage boundary'
        event cancelled 'Stage boundary cancellation'
        rc=130
    elif ((FAILED > 0)); then
        error "Maintenance finished with $FAILED failed stage(s) and $WARNINGS warning(s)."
        write_status failed "$FAILED failed stage(s); $WARNINGS warning(s)"
        event finished "partial failure: $FAILED stage(s)" 1
        rc=1
    elif ((WARNINGS > 0)); then
        warn "Maintenance finished with $WARNINGS warning(s) requiring review."
        write_status partial "$WARNINGS warning(s) require review"
        event finished "warnings: $WARNINGS" 2
        rc=2
    else
        info '[OK] Maintenance finished'
        write_status completed 'All stages completed successfully'
        event finished 'all stages completed'
    fi
    if [[ "$SYSUP_TTY_COLOR" == 1 ]]; then color=yes; fi
    summary_report save_print "$STATE" "$color" || warn 'Final summary unavailable'
    return "$rc"
}

execute_run() {
    local workflow="$1" root="$2" target_uid="$3" resume="$4" unit="$5" runid="$6"
    MODE="$workflow"; ROOT="$root"; TARGET_UID="$target_uid"
    RESUME="$resume"; UNIT="$unit"; RUN_ID="$runid"
    local passwd
    passwd="$(getent passwd "$TARGET_UID")" || { error 'Unknown UID'; return 2; }
    IFS=: read -r TARGET_USER _ _ _ _ TARGET_HOME _ <<< "$passwd"
    [[ "$TARGET_UID" =~ ^[0-9]+$ && "$TARGET_UID" != 0 && -f "$ROOT/bootstrap.sh" ]] || { error 'Invalid worker parameters'; return 2; }
    if [[ "$MODE" == automatic ]]; then
        ((EUID == 0)) || { error 'Automatic worker must be launched by systemd as root'; return 2; }
        STATE="$SYSTEM_STATE_BASE/uid-$TARGET_UID"
        install -d -m 0755 -- "$SYSTEM_STATE_BASE" "$STATE"
    else
        ((EUID != 0)) || { error 'Interactive run must not be root'; return 2; }
        STATE="$USER_STATE"
    fi
    setup_run_state || return $?
    if ((RESUME)); then
        apt_clean || { error 'dpkg audit failed; resolve before resume'; FAILED=1; finish_run; return 1; }
    fi
    # APT failures block only APT upgrades, not independent package ecosystems.
    if apt_clean; then
        run_stage apt_metadata 'APT repository metadata' - run_apt_update
        if grep -Fqx apt_metadata "$STATE/completed.txt"; then
            run_stage apt_upgrade 'APT package upgrades' - run_apt_upgrade
        else
            warn 'Skipping APT upgrade because metadata refresh failed.'
        fi
    else
        ((FAILED+=1))
        event stage_failed 'dpkg --audit reports incomplete configuration' 1
        warn 'APT skipped: run sudo dpkg --configure -a after checking the issue.'
    fi
    ((CANCEL_REQUESTED)) && { finish_run; return $?; }
    if command -v flatpak >/dev/null 2>&1; then
        run_stage flatpak 'Flatpak updates' dl.flathub.org run_flatpak
    fi
    ((CANCEL_REQUESTED)) && { finish_run; return $?; }
    if command -v snap >/dev/null 2>&1; then
        run_stage snap 'Snap refresh' api.snapcraft.io root_cmd snap refresh
    fi
    ((CANCEL_REQUESTED)) && { finish_run; return $?; }
    if [[ -n "$(user_cmd /bin/sh -c 'command -v rustup' 2>/dev/null || true)" ]]; then
        run_stage rustup 'Rust toolchains' static.rust-lang.org run_rustup
    fi
    ((CANCEL_REQUESTED)) && { finish_run; return $?; }
    # These installer scripts must never execute as root, even under systemd.
    local item
    for item in helix bottom herdr codex; do
        ((CANCEL_REQUESTED)) && { finish_run; return $?; }
        if [[ "$item" == codex ]]; then
            run_stage "$item" "$item stable release" chatgpt.com user_cmd bash "$ROOT/scripts/install-$item.sh"
        else
            run_stage "$item" "$item stable release" api.github.com user_cmd bash "$ROOT/scripts/install-$item.sh"
        fi
    done
    ((CANCEL_REQUESTED)) && { finish_run; return $?; }
    if command -v fwupdmgr >/dev/null 2>&1; then
        run_stage firmware 'Firmware check (report only)' - firmware_report
    fi
    finish_run
}

check_updates() {
    info 'Read-only APT simulation (phased updates stay phased)'
    apt-get -s --no-remove full-upgrade
    if command -v flatpak >/dev/null; then flatpak remote-ls --user --updates || true; fi
    if command -v snap >/dev/null; then snap refresh --list || true; fi
    if command -v rustup >/dev/null; then rustup check || true; fi
}

doctor() {
    info 'Read-only maintenance diagnostics'
    dpkg --audit || true
    ps -eo pid,ppid,stat,cmd | grep -E '[a]pt-get|[d]pkg|[w]hiptail' || true
    for host in api.snapcraft.io dl.flathub.org; do
        if timeout 15 getent ahosts "$host" >/dev/null 2>&1; then info "DNS OK: $host"; else warn "DNS FAIL: $host"; fi
    done
    systemctl --version | head -1
    if command -v findmnt >/dev/null 2>&1; then
        info "Root filesystem: $(findmnt -n -o FSTYPE / 2>/dev/null || echo unknown)"
    fi
    if command -v timeshift >/dev/null 2>&1; then
        info 'Timeshift detected; snapshots/rollback require separate manual configuration.'
    else
        warn 'No Timeshift executable detected. Automatic rollback is not supported.'
    fi
    info 'APT locks must NEVER be deleted manually.'
}

show_status() {
    local f unit
    for f in "$USER_STATE/status.json" "$SYSTEM_STATE_BASE/uid-$CALLER_UID/status.json"; do
        if [[ -r "$f" ]]; then
            if [[ -r "$(dirname "$f")/summary.json" ]] &&
               [[ "$(get_field "$f" run_id 2>/dev/null || true)" == "$(get_field "$(dirname "$f")/summary.json" run_id 2>/dev/null || true)" ]]; then
                summary_report view "$(dirname "$f")" auto || true
            else
                printf '\n%s\n' "$f"
                python3 -m json.tool "$f" || true
            fi
            local spid smode sphase
            spid="$(get_field "$f" pid || true)"
            smode="$(get_field "$f" mode || true)"
            sphase="$(get_field "$f" status || true)"
            if [[ "$smode" == interactive && "$sphase" == running && "$spid" =~ ^[0-9]+$ ]] && ! kill -0 "$spid" 2>/dev/null; then
                warn "Interactive status is stale (PID $spid not running); use sysup doctor."
            fi
            unit="$(get_field "$f" unit || true)"
            if [[ -n "$unit" && "$unit" == kubuntu-sysup-*.service ]]; then
                systemctl show "$unit" -p ActiveState -p SubState -p MainPID --no-pager 2>/dev/null || true
            fi
        fi
    done
}

show_summary() {
    local f found=0
    for f in "$USER_STATE/summary.json" "$SYSTEM_STATE_BASE/uid-$CALLER_UID/summary.json"; do
        if [[ -r "$f" ]]; then
            summary_report view "$(dirname "$f")" auto || true
            found=1
        fi
    done
    if ((found == 0)); then
        warn 'No completed update summary has been saved.'
        return 1
    fi
}

show_logs() {
    local f unit
    f="$(find "$USER_STATE" -maxdepth 1 -type f -name 'sysup-*.log' -printf '%T@ %p\n' 2>/dev/null | sort -nr | head -1 | cut -d' ' -f2-)"
    if [[ -n "$f" ]]; then printf '%s\n' "==> $f"; tail -n 80 "$f"; fi
    unit="$(get_field "$SYSTEM_STATE_BASE/uid-$CALLER_UID/status.json" unit 2>/dev/null || true)"
    if [[ "$unit" == kubuntu-sysup-*.service ]]; then
        info "Detached service logs: $unit"
        sudo journalctl --unit "$unit" -n 100 --no-pager
    fi
}

cancel_run() {
    local root_status="$SYSTEM_STATE_BASE/uid-$CALLER_UID/status.json" unit pid mode
    unit="$(get_field "$root_status" unit 2>/dev/null || true)"
    if [[ "$unit" == kubuntu-sysup-*.service ]]; then
        pid="$(get_field "$root_status" pid 2>/dev/null || true)"
        if [[ "$pid" =~ ^[0-9]+$ && "$pid" != 0 && -r "/proc/$pid/cgroup" && -r "/proc/$pid/cmdline" ]] && \n           grep -Fq "$unit" "/proc/$pid/cgroup" && \n           tr '\0' ' ' < "/proc/$pid/cmdline" | grep -Fq '__execute'; then
            sudo kill -USR1 "$pid"
            info 'Cancellation requested; detached worker will finish its current stage.'
            return 0
        fi
    fi
    local interactive_status="$USER_STATE/status.json"
    pid="$(get_field "$interactive_status" pid 2>/dev/null || true)"
    mode="$(get_field "$interactive_status" mode 2>/dev/null || true)"
    if [[ "$mode" == interactive && "$pid" =~ ^[0-9]+$ && -r "/proc/$pid/cmdline" ]] && \
       tr '\0' ' ' < "/proc/$pid/cmdline" | grep -Fq '__execute'; then
        kill -USR1 "$pid"
        info 'Cancellation requested; interactive worker will finish its current stage.'
    else
        warn 'No active sysup worker found.'
        return 1
    fi
}

launch_auto() {
    local resume="$1" uid unit lock
    uid="$(id -u)"
    ((uid != 0)) || { error 'Run sysup as your desktop user, not root'; return 2; }
    command -v systemd-run >/dev/null || { error 'systemd-run is required'; return 2; }
    [[ -f "$ROOT/bootstrap.sh" ]] || { error "Repository not found: $ROOT"; return 2; }
    ROOT="$(readlink -f -- "$ROOT")"
    mkdir -p -- "$USER_STATE"
    lock="$USER_STATE/bootstrap.lock"
    [[ -e "$lock" ]] || (umask 077; : > "$lock")
    [[ -f "$lock" && ! -L "$lock" ]] || { error 'Unsafe bootstrap lock path'; return 2; }
    if ! flock -n -E 75 "$lock" true; then error 'Bootstrap/sysup already running'; return 75; fi
    unit="kubuntu-sysup-${uid}-${RUN_ID//[^a-zA-Z0-9-]/}.service"
    info 'Authenticating to install a root-owned worker and start detached systemd service.'
    sudo -v || return $?
    sudo install -D -o root -g root -m 0755 -- "$SELF" "$WORKER_BINARY" || return $?
    sudo systemd-run --collect --unit "$unit" --property Type=exec \
        --property KillMode=mixed --property TimeoutStopSec=1200 \
        "$WORKER_BINARY" __worker "$uid" "$ROOT" "$RUN_ID" "$unit" "$resume" || return $?
    info "Started $unit. Terminal may now be closed."
    info 'Use: sysup status | sysup logs | sysup cancel'
}

main() {
    local action="${1:-apply}" resume=0
    case "$action" in
      help|-h|--help) usage ;;
      check|-c|--check) check_updates ;;
      doctor) doctor ;;
      status) show_status ;;
      summary) show_summary ;;
      logs) show_logs ;;
      cancel) cancel_run ;;
      apply|--apply|auto|--automatic|resume)
        ((EUID != 0)) || { error 'Invoke as normal desktop user, never sudo sysup'; return 2; }
        [[ -f "$ROOT/bootstrap.sh" ]] || { error "Repository not found: $ROOT"; return 2; }
        ROOT="$(readlink -f -- "$ROOT")"
        if [[ "$action" == resume ]]; then
            resume=1
            [[ "${2:-}" == '' || "${2:-}" == --auto ]] || { usage; return 2; }
            if [[ "${2:-}" == --auto ]]; then action=auto; else action=apply; fi
        else
            (($# == 1 || $# == 0)) || { usage; return 2; }
        fi
        if [[ "$action" == auto || "$action" == --automatic ]]; then
            launch_auto "$resume"
        else
            mkdir -p "$USER_STATE"
            [[ -e "$USER_STATE/bootstrap.lock" ]] || : > "$USER_STATE/bootstrap.lock"
            info 'Interactive mode: keep this terminal open until completion.'
            sudo -v || return $?
            info 'Proposed APT changes (cached metadata; simulated):'
            apt-get -s --no-remove full-upgrade || return $?
            printf 'Apply available updates? [y/N] ' > /dev/tty
            local answer
            IFS= read -r answer < /dev/tty || return 1
            case "$answer" in y|Y|yes|YES) ;; *) info 'Cancelled'; return 0;; esac
            locked_execute "$USER_STATE" interactive "$ROOT" "$CALLER_UID" "$resume" '' "$RUN_ID"
        fi
        ;;
      __execute)
        shift
        execute_run "$@"
        ;;
      __worker)
        # Trusted root-owned copy is the only supported privileged entrypoint.
        [[ "$SELF" == "$WORKER_BINARY" && "$EUID" == 0 ]] || { error 'Invalid worker entrypoint'; return 2; }
        shift
        local uid="$1" root="$2" run="$3" unit="$4" resumeflag="$5" home
        [[ "$uid" =~ ^[0-9]+$ && "$uid" != 0 ]] || return 2
        home="$(getent passwd "$uid" | cut -d: -f6)"
        [[ -n "$home" ]] || return 2
        USER_STATE="$home/.local/state/kubuntu-config"
        [[ -f "$USER_STATE/bootstrap.lock" && ! -L "$USER_STATE/bootstrap.lock" ]] || { error 'Missing or unsafe shared lock'; return 2; }
        locked_execute "$USER_STATE" automatic "$root" "$uid" "$resumeflag" "$unit" "$run"
        ;;
      *) usage; return 2 ;;
    esac
}
main "$@"
