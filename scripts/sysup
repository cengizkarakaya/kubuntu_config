#!/usr/bin/env bash
set -Eeuo pipefail
echo '==> APT refresh and full upgrade (package removal prohibited)'
sudo apt-get update
sudo apt-get full-upgrade --no-remove
if command -v flatpak >/dev/null 2>&1; then
  echo '==> Flatpak user applications and runtimes'
  flatpak update --user
fi
if command -v snap >/dev/null 2>&1; then
  echo '==> Existing Snap packages'
  sudo snap refresh
fi
if command -v rustup >/dev/null 2>&1; then
  echo '==> Rust toolchain'
  rustup update
fi
if command -v fwupdmgr >/dev/null 2>&1; then
  echo '==> Firmware update availability (report only, never flash)'
  fwupdmgr get-updates || echo '[WARN] Firmware check unavailable'
fi
echo 'No optional application plugins are installed or updated.'
echo 'No unattended firmware flashing, vendor GPU driver install, or release upgrade.'
