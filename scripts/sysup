#!/usr/bin/env bash
set -Eeuo pipefail
# Never silently upgrade distribution releases, kernel drivers from third-party installers, or EFI.
echo '==> APT refresh/upgrade'
sudo apt-get update
sudo apt-get full-upgrade
if command -v flatpak >/dev/null 2>&1; then
  echo '==> Flatpak user apps'
  flatpak update --user
fi
if command -v snap >/dev/null 2>&1; then
  echo '==> Existing Snap packages'
  sudo snap refresh
fi
if command -v rustup >/dev/null 2>&1; then
  echo '==> Rust stable toolchain'
  rustup update
fi
if command -v fwupdmgr >/dev/null 2>&1; then
  echo '==> Available firmware updates (report only)'
  fwupdmgr get-updates || echo '[WARN] Firmware check unavailable; no firmware flashed.'
fi
echo '==> App-specific extensions are intentionally not installed or updated.'
echo '==> NVIDIA drivers, kernel selection, GRUB, EFI and distribution upgrades remain OS/user managed.'
