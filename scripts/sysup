#!/usr/bin/env bash
set -Eeuo pipefail

export PATH="$HOME/.cargo/bin:$HOME/.local/bin:$PATH"

MODE="${1:---apply}"
ROOT="${KUBUNTU_CONFIG_ROOT:-$HOME/kubuntu_config}"

case "$MODE" in
    -c|--check)
        MODE="--check"
        ;;
    --apply)
        ;;
    *)
        echo "Usage: sysup [-c|--check|--apply]" >&2
        exit 2
        ;;
esac

[[ -f "$ROOT/bootstrap.sh" ]] || {
    echo "[FAIL] Kubuntu_Config repository not found: $ROOT" >&2
    exit 1
}

STATE="$HOME/.local/state/kubuntu-config"
mkdir -p "$STATE"

# Prevent concurrent maintenance operations.
exec 9>"$STATE/bootstrap.lock"
flock -n 9 || {
    echo "[FAIL] Another maintenance operation is running"
    exit 1
}

LOG="$STATE/sysup-$(date +%Y%m%d-%H%M%S).log"

# Authenticate before redirecting output through tee/awk.
if [[ "$MODE" == "--apply" ]]; then
    echo "[INFO] Sudo kimlik doğrulaması"
    sudo -v
fi
# Colorize the approval prompt without filtering command output.
# NO_COLOR disables colors; SYSUP_COLOR overrides detection.
case "${SYSUP_COLOR:-auto}" in
    always)
        use_color=1
        ;;
    never)
        use_color=0
        ;;
    auto)
        if [[ -z "${NO_COLOR+x}" &&
              "${TERM:-dumb}" != "dumb" ]]; then
            use_color=1
        else
            use_color=0
        fi
        ;;
    *)
        echo "Invalid SYSUP_COLOR value" >&2
        exit 2
        ;;
esac

# Stream output directly through tee to the terminal without line buffering.
# Only the secondary log branch strips ANSI colors; terminal progress remains live.
exec > >(tee >(sed -u -E 's/\x1B\[[0-9;]*[[:alpha:]]//g' >> "$LOG")) 2>&1

# Nord-friendly terminal highlights. Respect NO_COLOR and SYSUP_COLOR.
colored() {
    local ansi_code="$1"
    shift
    if (( use_color )); then
        printf '\033[%sm%s\033[0m\n' "$ansi_code" "$*"
    else
        printf '%s\n' "$*"
    fi
}

section() { echo; colored '1;34' "==> $*"; }
info()    { colored '0;36' "[INFO] $*"; }
ok()      { colored '1;32' "[OK] $*"; }
warn()    { colored '1;33' "[WARN] $*"; }
fail()    { colored '1;31' "[FAIL] $*"; }

# Show colored stage headers and periodic progress even for silent installers.
# The heartbeat's sleep never inherits the output pipe (prevents delayed exit).
run_stage() {
    local label="$1"
    local rc=0
    local started=$SECONDS
    shift

    stage_index=$((stage_index + 1))
    section "[$stage_index/$stage_total] $label"
    (
        while sleep 5 >/dev/null 2>&1; do
            info "$label devam ediyor ($((SECONDS - started)) sn)"
        done
    ) &
    local heartbeat_pid=$!

    "$@" || rc=$?

    kill "$heartbeat_pid" 2>/dev/null || true
    wait "$heartbeat_pid" 2>/dev/null || true

    if ((rc != 0)); then
        fail "$label başarısız (çıkış kodu: $rc)"
        return "$rc"
    fi
    ok "$label tamamlandı ($((SECONDS - started)) sn)"
}

colored '1;36' "=== Kubuntu_Config System Update ==="
info "Mode: $MODE"
info "Log: $LOG"

if [[ "$MODE" == "--check" ]]; then
    echo
    section "APT simulation"
    apt-get -s --no-remove full-upgrade

    if command -v flatpak >/dev/null 2>&1; then
        echo
        section "Flatpak pending updates"
        flatpak remote-ls --user --updates ||
            echo "[WARN] Flatpak update check unavailable"
    fi

    if command -v rustup >/dev/null; then
        echo
        section "Rust toolchains"
        rustup check
    fi

    if command -v snap >/dev/null; then
        echo
        section "Snap pending updates"
        snap refresh --list || true
    fi

    echo
    section "Installed standalone tools"

    for cmd in hx herdr btm codex; do
        if command -v "$cmd" >/dev/null; then
            "$cmd" --version
        else
            echo "[WARN] $cmd unavailable"
        fi
    done

    echo
    ok "Read-only check completed"
    echo "For full version audit:"
    echo "bash $ROOT/scripts/version-audit.sh"
    exit 0
fi

echo
section "Refreshing APT metadata"
sudo apt-get update

echo
section "Proposed APT changes"
apt-get -s --no-remove full-upgrade

echo
echo "Updates may include kernel and NVIDIA driver packages."
echo "Run this outside active Herdr/Codex sessions."
info "Kullanıcı onayı bekleniyor"

# Ask directly on the controlling terminal.
# Do not route the interactive prompt through tee/awk.
if [[ "$use_color" == 1 ]]; then
    printf '\033[1;33m[ONAY]\033[0m Güncellemeler uygulansın mı? [y/N] ' > /dev/tty
else
    printf '[ONAY] Güncellemeler uygulansın mı? [y/N] ' > /dev/tty
fi

if ! IFS= read -r answer < /dev/tty; then
    info "Giriş kapatıldı; güncelleme iptal edildi"
    exit 0
fi

case "$answer" in
    y|Y|yes|YES) ;;
    *)
        info "Update cancelled"
        exit 0
        ;;
esac

info "Onay alındı; güncellemeler başlatılıyor."

stage_total=5   # APT + Helix + Bottom + Herdr + Codex
for tool in flatpak snap rustup fwupdmgr; do
    if command -v "$tool" >/dev/null 2>&1; then
        stage_total=$((stage_total + 1))
    fi
done
stage_index=0

run_stage "APT paket güncellemeleri" sudo apt-get full-upgrade --no-remove --yes

if command -v flatpak >/dev/null; then
    run_stage "Flatpak güncellemeleri" flatpak update --user --assumeyes
fi

if command -v snap >/dev/null; then
    run_stage "Snap güncellemeleri" sudo snap refresh
fi

if command -v rustup >/dev/null; then
    rustup_path="$(readlink -f "$(command -v rustup)")"

    if command -v dpkg-query >/dev/null 2>&1 &&
       dpkg-query -S "$rustup_path" >/dev/null 2>&1; then
        info "APT-managed rustup: toolchain updates only"
        run_stage "Rust toolchain güncellemeleri" rustup update --no-self-update
    else
        run_stage "Rust toolchain güncellemeleri" rustup update
    fi
fi

echo
section "Standalone development tools"

run_stage "Helix güncellemesi" bash "$ROOT/scripts/install-helix.sh"
run_stage "Bottom güncellemesi" bash "$ROOT/scripts/install-bottom.sh"
run_stage "Herdr güncellemesi" bash "$ROOT/scripts/install-herdr.sh"
run_stage "Codex güncellemesi" bash "$ROOT/scripts/install-codex.sh"

if command -v fwupdmgr >/dev/null; then
    run_stage "Firmware kontrolü (yalnızca rapor)" fwupdmgr get-updates ||
        warn "Firmware kontrolü kullanılamıyor"
fi

echo
ok "Update operations completed"
echo "Review the log and run: bash $ROOT/verify.sh"
echo "Log: $LOG"
echo "A logout/login may be required after KDE updates."
