#!/usr/bin/env bash

set -u

read -r -p "Search text: " query
[[ -n "$query" ]] || exit 0

# Debian/Kubuntu uses 'batcat' for the command named 'bat' on Arch.
if command -v bat >/dev/null 2>&1; then
    export YAZI_BAT_PREVIEW_CMD=bat
elif command -v batcat >/dev/null 2>&1; then
    export YAZI_BAT_PREVIEW_CMD=batcat
else
    printf 'Yazi search preview requires bat or batcat (APT package: bat)\n' >&2
    exit 1
fi

result="$(
    rg \
        --vimgrep \
        --smart-case \
        --hidden \
        --glob '!.git' \
        -- "$query" . 2>/dev/null |
    fzf \
        --delimiter ':' \
        --prompt='rg> ' \
        --preview '"$YAZI_BAT_PREVIEW_CMD" --color=always --style=numbers --highlight-line {2} -- {1}' \
        --preview-window='right,60%,border-left'
)" || exit 0

file="${result%%:*}"
rest="${result#*:}"

line="${rest%%:*}"
rest="${rest#*:}"

column="${rest%%:*}"

if command -v hx >/dev/null 2>&1; then
    exec hx "$file:$line:$column"
elif command -v helix >/dev/null 2>&1; then
    exec helix "$file:$line:$column"
else
    printf 'No Helix editor available (hx or helix)\n' >&2
    exit 1
fi
