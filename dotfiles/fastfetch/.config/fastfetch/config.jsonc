{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "source": "ubuntu",
        "color": {
            "1": "cyan",
            "2": "blue"
        }
    },

    "display": {
        "separator": ": ",
        "color": {
            "keys": "cyan",
            "title": "blue",
            "output": "white",
            "separator": "bright_black"
        }
    },

    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "display",
        "wm",
        "theme",
        "icons",
        "font",
        "cursor",
        "terminal",
        "terminalfont",
        "cpu",
        "gpu",
        "memory",
        "swap",
        "disk",
        "localip",
        "locale",
        "break",
        "colors"
    ]
}
