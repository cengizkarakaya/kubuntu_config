<?xml version="1.0"?>
<robot name="tio" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- TIO visual/kinematic placeholder, NOT a measured CAD or dynamics model.
       REP-103: x forward, y left, z up; base_footprint on ground at z=0.
       Values below are in metres. Replace them after the chassis is measured. -->
  <xacro:property name="body_length" value="0.38"/>
  <xacro:property name="body_width" value="0.21"/>
  <xacro:property name="body_height" value="0.095"/>
  <xacro:property name="body_center_height" value="0.11"/>
  <xacro:property name="wheel_radius" value="0.06"/>
  <xacro:property name="wheel_width" value="0.038"/>
  <xacro:property name="wheelbase" value="0.27"/>
  <xacro:property name="wheel_track" value="0.27"/>
  <xacro:property name="pi" value="3.141592653589793"/>

  <material name="graphite"><color rgba="0.095 0.12 0.15 1"/></material>
  <material name="hood_metal"><color rgba="0.18 0.23 0.27 1"/></material>
  <material name="rubber"><color rgba="0.027 0.033 0.038 1"/></material>
  <material name="amber"><color rgba="0.95 0.42 0.07 1"/></material>
  <material name="glass"><color rgba="0.05 0.54 0.64 1"/></material>

  <link name="base_footprint"/>
  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${body_center_height}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
      <material name="graphite"/>
    </visual>
    <collision>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
    </collision>
  </link>

  <xacro:macro name="wheel" params="name x y">
    <link name="${name}_link">
      <visual>
        <origin rpy="${pi/2.0} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="rubber"/>
      </visual>
      <collision>
        <origin rpy="${pi/2.0} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${x} ${y} ${wheel_radius-body_center_height}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- Provisional four-wheel arrangement; steering geometry is TBD. -->
  <xacro:wheel name="front_left_wheel" x="${wheelbase/2.0}" y="${wheel_track/2.0}"/>
  <xacro:wheel name="front_right_wheel" x="${wheelbase/2.0}" y="${-wheel_track/2.0}"/>
  <xacro:wheel name="rear_left_wheel" x="${-wheelbase/2.0}" y="${wheel_track/2.0}"/>
  <xacro:wheel name="rear_right_wheel" x="${-wheelbase/2.0}" y="${-wheel_track/2.0}"/>

  <!-- Lower, forward nose/hood containing the camera mount. -->
  <link name="front_hood_link">
    <visual>
      <geometry><box size="0.12 0.19 0.045"/></geometry>
      <material name="hood_metal"/>
    </visual>
  </link>
  <joint name="front_hood_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_hood_link"/>
    <origin xyz="0.165 0 -0.025"/>
  </joint>

  <!-- Low-profile, partly recessed LiDAR housing on upper chassis. -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.029" length="0.022"/></geometry>
      <material name="glass"/>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="-0.04 0 0.045"/>
  </joint>

  <!-- Two-axis front gimbal; this is only the kinematic housing, no camera stream. -->
  <link name="camera_pan_link">
    <visual>
      <geometry><cylinder radius="0.021" length="0.014"/></geometry>
      <material name="amber"/>
    </visual>
  </link>
  <joint name="camera_pan_joint" type="revolute">
    <parent link="base_link"/>
    <child link="camera_pan_link"/>
    <origin xyz="0.224 0 0.008"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.2" upper="1.2" effort="1" velocity="1"/>
  </joint>

  <link name="camera_tilt_link">
    <visual>
      <geometry><box size="0.043 0.046 0.033"/></geometry>
      <material name="hood_metal"/>
    </visual>
  </link>
  <joint name="camera_tilt_joint" type="revolute">
    <parent link="camera_pan_link"/>
    <child link="camera_tilt_link"/>
    <origin xyz="0.012 0 0.017"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.55" upper="0.55" effort="1" velocity="1"/>
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0.027 0 0" rpy="0 ${pi/2.0} 0"/>
      <geometry><cylinder radius="0.012" length="0.009"/></geometry>
      <material name="glass"/>
    </visual>
  </link>
  <joint name="camera_mount_joint" type="fixed">
    <parent link="camera_tilt_link"/>
    <child link="camera_link"/>
    <origin xyz="0.01 0 0"/>
  </joint>
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0.035 0 0" rpy="${-pi/2.0} 0 ${-pi/2.0}"/>
  </joint>

  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="-0.055 0 -0.005"/>
  </joint>
</robot>
