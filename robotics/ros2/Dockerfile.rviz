# Optional ROS 2 graphical tools (RViz2/rqt/PlotJuggler) using NVIDIA XWayland.
# Lyrical plotjuggler_ros APT plugin package is NOT available (upstream issue #119).
# PlotJuggler 3 is usable for offline data; rqt_plot handles live ROS data.
FROM kubuntu-config/ros2-lyrical-dev:local

ARG ROS_UID=1000
ARG ROS_GID=1000

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ros-lyrical-rviz2 \
        ros-lyrical-rqt \
        ros-lyrical-rqt-graph \
        ros-lyrical-rqt-console \
        ros-lyrical-rqt-image-view \
        ros-lyrical-rqt-topic \
        ros-lyrical-rqt-plot \
        ros-lyrical-plotjuggler \
        mesa-utils \
        xauth \
    && rm -rf /var/lib/apt/lists/* \
    && bash -lc 'source /opt/ros/lyrical/setup.bash && command -v rviz2 && ros2 pkg prefix rviz2 && ros2 pkg prefix rqt_gui && ros2 pkg prefix rqt_plot && ros2 pkg prefix plotjuggler' \
    && command -v glxinfo \
    && mkdir -p /tmp/runtime-rosdev \
    && chown "${ROS_UID}:${ROS_GID}" /tmp/runtime-rosdev \
    && chmod 0700 /tmp/runtime-rosdev

ENV HOME=/home/rosdev
ENV XDG_RUNTIME_DIR=/tmp/runtime-rosdev
USER ${ROS_UID}:${ROS_GID}
WORKDIR /workspaces
CMD ["sleep", "infinity"]
